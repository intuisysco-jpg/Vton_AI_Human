# The GPU server's existing ML environment; used by both pipelines/upscalers.
VT_CONDA_ENV=qwen21
RABBITMQ_URL=amqp://worker:CHANGE_ME@rabbitmq:5672/
# Restricted worker login, never the API/migration administrator login.
VT_DATABASE_URL=postgresql://worker:CHANGE_ME@DATABASE_HOST:5432/postgres?sslmode=require
VT_STORAGE_ROOT=/data/storage/jobs
VT_GPU_LOCK_PATH=/data/gpu-coord/gpu.lock
